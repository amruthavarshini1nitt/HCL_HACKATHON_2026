# Copy to .env and fill in. Never commit .env.

# Embeddings (required)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# LLM (any OpenAI-compatible endpoint). Falls back to OPENAI_API_KEY if blank.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# VLM: Qwen2.5-VL-7B-Instruct through a hosted OpenAI-compatible endpoint
VLM_API_KEY=
VLM_BASE_URL=https://openrouter.ai/api/v1
# 7B is not served on OpenRouter; 72B is the same Qwen2.5-VL family. Use another host for 7B.
VLM_MODEL=qwen/qwen2.5-vl-72b-instruct

# Hugging Face (Prompt Guard 2 is gated: accept Meta's license first)
HF_TOKEN=
RERANKER_MODEL=BAAI/bge-reranker-base
PROMPT_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-22M
# Set false until gated access is approved (avoids slow failed downloads on first query)
PROMPT_GUARD_ENABLED=true

# Qdrant: leave QDRANT_URL empty for embedded local mode
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=researchiq

# Limits
MAX_FILE_MB=50
MAX_PAGES=80
MAX_QUERY_CHARS=1000
RATE_LIMIT_PER_MIN=20

# Retrieval
TOP_K_DENSE=20
TOP_K_BM25=20
RERANK_TOP_N=6

LOG_LEVEL=INFO

# Answer validation
EVIDENCE_MIN_RELEVANCE=0.1
CLAIM_OVERLAP_MIN=0.3
MAX_ANSWER_RETRIES=1
